# Copy this file to .env and change the local API key before running.
SENTINELRAG_API_KEY=replace-with-a-long-random-local-key
SENTINELRAG_MIN_SIMILARITY=0.10
SENTINELRAG_RATE_LIMIT=10
SENTINELRAG_RATE_WINDOW_SECONDS=60
SENTINELRAG_MAX_QUESTION_CHARS=2000
SENTINELRAG_DB_PATH=data/sentinelrag.db
SENTINELRAG_DATA_DIR=data

# Optional LLM mode. Keep real values only in .env (never commit it).
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
